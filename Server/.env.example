# Default: local rules until configured; a remembered local configuration is restored.
AIFARM_PROVIDER=mock

# To force an isolated offline run, set AIFARM_IGNORE_SAVED_CONFIG=1.
# For explicit environment configuration select AIFARM_PROVIDER=openai.
AIFARM_PROTOCOL=chat_completions
AIFARM_OUTPUT_MODE=text
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
# Leave empty for an unauthenticated local server. Never commit a real Key.
OPENAI_API_KEY=

# Opt in explicitly; the default test suite never calls the real API.
RUN_DEEPSEEK_INTEGRATION=0
