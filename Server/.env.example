# Safe default: never calls a model.
AIFARM_PROVIDER=mock

# OpenAIProvider uses DeepSeek's OpenAI-compatible Responses API.
# These values are ignored while AIFARM_PROVIDER=mock.
OPENAI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=<your DeepSeek API key>

# Opt in explicitly; the default test suite never calls the real API.
RUN_DEEPSEEK_INTEGRATION=0
